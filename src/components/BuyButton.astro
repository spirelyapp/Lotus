---
interface Props {
  /**
   * Always the local /buy page. There used to be a 'stripe' target that
   * skipped it, which cannot exist now that checkout is per-colour: a cart
   * permalink names one variant, so a direct link would choose for the buyer.
   * ColourChoice does that job on /buy.
   */
  label?: string;
  variant?: 'solid' | 'outline';
  size?: 'md' | 'lg';
}

const {
  label = 'Get Stick',
  variant = 'solid',
  size = 'md',
} = Astro.props;

const href = '/buy';
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-full font-medium transition-colors',
    size === 'lg' ? 'px-8 py-4 text-[17px]' : 'px-6 py-3 text-[15px]',
    variant === 'solid'
      ? 'bg-accent text-white hover:bg-accent-dark'
      : 'border border-ink hover:bg-ink hover:text-white',
  ]}
>
  {label}
</a>

---
import Wordmark from './Wordmark.astro';
import { nav, site } from '../config';
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md"
>
  <div class="bg-ink text-center text-[13px] text-white/85">
    <p class="mx-auto max-w-6xl px-5 py-2.5">
      Pre-order. Shipping {site.shipWindow}, first units {site.earlyShipWindow}. <a
        href="/buy"
        class="underline underline-offset-4 hover:text-white">Get Stick</a
      >
    </p>
  </div>

  <nav class="mx-auto max-w-6xl px-5 py-4" aria-label="Primary">
    <div class="flex items-center gap-6">
      {/* Widths are set so the letters land where they did before the mark
          gained its full stop: the stop and its sidebearing are the last 8%
          of the artwork, so 72px here draws the same 66px of "stick".

          -my-1.5 py-1.5 grows the tap target without moving anything. The
          artwork's 2.87 aspect makes 72px only 25px tall, close enough to the
          24px WCAG minimum that a later trim would quietly break it. The
          negative margin cancels the padding in layout, so the hit area is
          37px while the row is not. */}
      <a
        href="/"
        class="-my-1.5 flex py-1.5 text-ink"
        aria-label="Stick home"
      >
        <Wordmark class="w-[72px] select-none md:w-[80px]" />
      </a>

      <ul class="-my-2 ml-2 hidden items-center gap-7 text-[15px] text-muted md:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-block py-2 transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="/buy"
        class="ml-auto rounded-full bg-accent px-5 py-2.5 text-[15px] font-medium text-white transition-colors hover:bg-accent-dark"
      >
        Get Stick
      </a>
    </div>

    {/* Small screens get the links on their own row rather than a hamburger:
        four destinations do not justify a menu.

        The links carry vertical padding so the tap target clears the 24px
        WCAG minimum. Text alone is 17px tall, which is small enough to
        mis-tap, and "FAQ" is only 27px wide. Do not remove the padding to
        tighten the row. */}
    <ul class="mt-1 flex items-center gap-5 text-[14px] text-muted md:hidden">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="inline-block py-2.5">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

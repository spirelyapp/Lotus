---
import { site } from '../config';

interface Props {
  /**
   * The price and shipping line. Off where the page already carries one
   * directly above, on where these buttons end a section by themselves.
   */
  showPrice?: boolean;
}

const { showPrice = true } = Astro.props;

/**
 * The buy control, now that the key comes in two colours.
 *
 * A single button cannot work here. The checkout links are Shopify cart
 * permalinks, and a permalink names one variant — so one button would pick a
 * colour on the buyer's behalf and never show them the other. Two buttons make
 * the choice explicit, and make it on our page rather than handing the buyer to
 * Shopify's product page to decide.
 *
 * The swatches are the actual colours, and they are decorative: each button
 * says its colour in text as well, so nothing here depends on seeing them.
 */
const colours = [
  { name: 'Hot pink', href: site.checkout.pink, swatch: 'bg-key' },
  { name: 'Gray', href: site.checkout.gray, swatch: 'bg-shell' },
];
---

<div>
  <p class="text-[15px] font-medium text-ink">Choose a colour</p>
  <div class="mt-4 flex flex-wrap gap-3">
    {
      colours.map((c) => (
        <a
          href={c.href}
          class="inline-flex items-center gap-3 rounded-full bg-accent px-7 py-4 text-[17px] font-medium text-white transition-colors hover:bg-accent-dark"
        >
          {/* ring-inset so a swatch always has an edge against the blue fill
              rather than reading as a hole punched in the button. It mattered
              most when this was black; it still keeps the pale gray from
              floating. */}
          <span
            aria-hidden="true"
            class:list={[
              'size-4 shrink-0 rounded-full ring-1 ring-white/40 ring-inset',
              c.swatch,
            ]}
          />
          {c.name}
        </a>
      ))
    }
  </div>
  {
    showPrice && (
      <p class="mt-4 text-[14px] text-muted">
        {site.price} plus shipping, calculated from your address at checkout.
      </p>
    )
  }
</div>

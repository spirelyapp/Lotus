---
import { nav, site } from '../config';
---

<footer class="rule mt-24 bg-mist">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <p class="text-xl font-bold tracking-[-0.05em]">Stick</p>
        <p class="mt-3 text-[15px] leading-relaxed text-muted">
          A USB key that blocks the sites and apps you choose on your Mac.
          Friction, not a prison.
        </p>
      </div>

      <div class="flex gap-14 text-[15px]">
        <ul class="space-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-muted hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="space-y-2.5">
          <li>
            <a href="/buy" class="text-muted hover:text-ink">Get Stick</a>
          </li>
          <li>
            <a href="/refunds" class="text-muted hover:text-ink">Refunds</a>
          </li>
          <li>
            <a href="/privacy" class="text-muted hover:text-ink">Privacy</a>
          </li>
          <li>
            <a href="/terms" class="text-muted hover:text-ink">Terms</a>
          </li>
          <li>
            {
              site.supportEmail ? (
                <a href={`mailto:${site.supportEmail}`} class="text-muted hover:text-ink">
                  Support
                </a>
              ) : (
                <span class="text-key">Support email — TODO</span>
              )
            }
          </li>
        </ul>
      </div>
    </div>

    <div
      class="rule mt-12 flex flex-col gap-2 pt-6 text-[13px] text-muted sm:flex-row sm:justify-between"
    >
      <p>
        © {new Date().getFullYear()} {site.legalEntity ?? site.name}
      </p>
      <p>macOS only. {site.minMacOS}, {site.architectures}.</p>
    </div>
  </div>
</footer>

---
import Wordmark from './Wordmark.astro';
import { site } from '../config';
import EmailForm from './EmailForm.astro';

/**
 * Dark footer with a full-bleed wordmark, in the spirit of Brick's.
 *
 * Column links are only ever to pages that exist. Padding a footer out with
 * Careers / Affiliates / Community links to nowhere is the cheapest possible
 * lie, and this site does not get to tell it.
 *
 * Text opacities are set for contrast, not taste: white/55 on #0a0a0b clears
 * 4.5:1, white/40 does not. Do not lighten these without re-measuring.
 */
const groups = [
  {
    heading: 'Product',
    links: [
      { label: 'How it works', href: '/#how-it-works' },
      { label: 'Our story', href: '/story' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'Ordering',
    links: [
      { label: 'Get Stick', href: '/buy' },
      { label: 'Updates', href: '/updates' },
      { label: 'Refunds', href: '/refunds' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Terms of sale', href: '/terms' },
      { label: 'Privacy', href: '/privacy' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink text-white">
  <div class="mx-auto max-w-6xl px-5 pt-20 pb-10 md:pt-24">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-3 md:gap-8">
      {
        groups.map((group) => (
          <div>
            <h2 class="text-[14px] text-white/55">{group.heading}</h2>
            {/* py-1.5 with no list gap gives the same 31px rhythm the
                12px gap did, while taking each tap target from 19px to
                31px. Do not swap it back for space-y without re-measuring. */}
            <ul class="mt-3.5 -mb-1.5 text-[16px]">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-block py-1.5 text-white/80 transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/*
      On every page, so it catches the visitor who read one thing and left.
      Tagged separately from the Windows and buy-page forms: "read something,
      not ready" is a different signal from "wants Windows" or "looked at the
      price and didn't", and they should not arrive as one undifferentiated list.

      The heading and copy are inside the same condition as the form, not just
      around it. EmailForm hides itself when there is no Buttondown username, so
      wrapping copy outside that guard puts "leave your email" on all ten pages
      with no field beneath it — an invitation the page cannot honour, which is
      worse than staying quiet.
    */}
    {
      site.buttondownUser && (
        <div class="mt-16 max-w-lg border-t border-white/10 pt-10 md:mt-20">
          <h2 class="text-[14px] text-white/55">Occasional updates</h2>
          <p class="mt-3 text-[16px] leading-relaxed text-white/80">
            When there's something worth saying — shipping dates, Windows, what
            changed. Not a newsletter.
          </p>
          <div class="mt-5">
            <EmailForm
              tag="footer"
              label="Email address"
              cta="Keep me posted"
              tone="dark"
              compact
            />
          </div>
        </div>
      )
    }

    <div
      class="mt-20 flex flex-col gap-10 md:mt-28 md:flex-row md:items-end md:justify-between"
    >
      {/* Decorative: the nav names the brand in text a few hundred pixels up,
          so the mark is aria-hidden and carries no alt text.

          The clamp is the old one divided through by 0.92, the share of the
          artwork the letters occupy now that the full stop is part of it. That
          keeps "stick" the size it was and lets the stop extend past it,
          rather than shrinking the word to make room. */}
      <div class="text-white">
        <Wordmark class="w-[clamp(16.25rem,63vw,37rem)] select-none" />
      </div>

      <div
        class="shrink-0 space-y-1 text-[13px] text-white/55 md:pb-3 md:text-right"
      >
        <p>{site.minMacOS}, {site.architectures}.</p>
        <p>{site.legalEntity ?? site.name} {year} © All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

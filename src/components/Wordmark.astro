---
interface Props {
  /** Sizing and colour come from the caller; the letters are currentColor. */
  class?: string;
}

const { class: className = '' } = Astro.props;

/**
 * The Stick wordmark, inline so it takes the colour of whatever it sits on.
 *
 * Three things here are deliberate:
 *
 * 1. The letters are `currentColor`, so the header sets `text-ink` and the
 *    footer `text-white` off one file. The old artwork was a white PNG the
 *    header had to `invert`, which worked only while the mark was pure white
 *    and would have broken silently the moment it was not.
 *
 * 2. The full stop is a path of its own so it can keep blinking. It belongs to
 *    the artwork now rather than being live text, which retires the whole
 *    business of aligning a glyph's baseline against an image's bottom edge.
 *
 * 3. The `k` is drawn already trimmed. In the source file its ascender is cut
 *    down by a white rectangle painted over the top of it — fine on a white
 *    page, a white block on the dark footer. Both points of the stem's top
 *    edge are moved to where that rectangle ended instead, which removes the
 *    same ink on any background and needs no id: two of these render per page,
 *    and a clip path would have meant the same id twice in one document.
 *
 * viewBox is the artwork cropped to its ink, so the box edges are the mark's
 * edges and callers can align to them.
 */
---

<svg
  viewBox="0 0 1146.61 399.72"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <g transform="translate(-52.2497,-269.2890)" fill="currentColor">
    <path transform="matrix(1,0,0,-1,302.1287,444.1599)" d="M0 0H-67.123C-72.2 26.51-91.378 38.921-126.349 38.921-157.937 38.921-179.371 28.202-179.371 9.024-179.371-11.28-161.886-22.562-105.479-33.279-15.794-49.638 9.589-77.84 9.589-122.964 9.589-183.883-46.253-217.728-120.709-217.728-197.421-217.728-248.186-183.32-249.879-116.197H-185.576C-181.628-150.605-159.629-166.961-119.58-166.961-80.096-166.961-54.714-155.679-54.714-130.298-54.714-109.992-67.687-94.762-148.913-80.661-197.421-72.2-243.674-50.764-243.674 6.206-243.674 60.92-190.088 89.685-121.837 89.685-52.458 89.685-6.204 58.099 0 0" />
    <path transform="matrix(1,0,0,-1,418.569,286.78663)" d="M0 0V-87.427H58.099V-135.372H0V-294.438C0-324.896 7.333-331.101 32.152-331.101 43.998-331.101 55.842-329.972 58.099-328.846V-378.483C32.717-381.302 25.383-381.868 16.359-381.868-45.124-381.868-64.302-362.125-64.302-303.463V-135.372H-112.812V-87.427H-64.302V0Z" />
    <path transform="matrix(1,0,0,-1,0,1080)" d="M554.255 414.94H489.952V625.467H554.255ZM554.255 661.708H489.952V705.68606H554.255Z" />
    <path transform="matrix(1,0,0,-1,0,1080)" d="M554.255 622.568H489.952V668.619H554.255Z" />
    <path transform="matrix(1,0,0,-1,842.7997,467.0741)" d="M0 0H-64.303C-69.38 34.971-93.634 54.714-130.861 54.714-180.499 54.714-210.958 19.178-210.958-51.33-210.958-107.736-183.883-151.168-133.681-151.168-97.018-151.168-71.071-128.606-64.303-84.608H0C-12.409-161.321-59.79-201.935-133.681-201.935-218.854-201.935-275.261-144.399-275.261-51.33-275.261 41.74-223.368 105.478-131.426 105.478-55.842 105.478-6.204 66.56 0 0" />
    <path transform="matrix(1,0,0,-1,916.1396,259.1499)" d="M0 -27.6367V-229.008L108.521-111.118H182.272L77.967-218.291 192.283-402.738H119.057L35.823-261.16 0-298.386V-402.738H-60.056V-27.6367Z" />
    <path transform="matrix(1,0,0,-1,0,1080)" d="M1198.862 471.948H1141.854V414.94H1198.862Z" class="animate-caret-blink" />
    {/* The tittle is the key itself, so it is painted in the key's own pink
        rather than the crimson the artwork arrived with — one token, so the
        mark and the object cannot drift apart. Decorative: the link beside it
        carries the name in text. */}
    <path transform="matrix(1,0,0,-1,526.0629,362.48689)" d="M0 0 103.339 41.238C105.391 42.057 106.39 44.384 105.572 46.435L88.15 90.093C87.331 92.145 85.004 93.144 82.952 92.325L-20.387 51.088C-22.438 50.269-23.438 47.942-22.619 45.89L-5.198 2.233C-4.379 .181-2.052-.819 0 0" class="fill-key" />
  </g>
</svg>

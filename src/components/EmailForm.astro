---
import { site } from '../config';

interface Props {
  /** Buttondown tag, so separate lists stay separate. */
  tag: string;
  label: string;
  cta?: string;
  compact?: boolean;
  /**
   * 'dark' is for the footer, which is white-on-ink. The light input would sit
   * on that as a bright slab, and its muted placeholder — tuned for contrast on
   * white — is not readable there.
   */
  tone?: 'light' | 'dark';
}

const {
  tag,
  label,
  cta = 'Get notified',
  compact = false,
  tone = 'light',
} = Astro.props;

// Measured against the rendered footer, not chosen by eye. Placeholder at
// white/55 gives 6.1:1 and typed text 18:1, both past the 4.5 AA needs. The
// border is the part that has to be watched: it is the only thing marking where
// the field is, so it is a UI boundary needing 3:1, and white/20 gave 1.77 —
// an input you could not see the edge of. white/40 measures 3.8.
const fieldClass =
  tone === 'dark'
    ? 'min-w-0 flex-1 rounded-full border border-white/40 bg-white/5 px-5 py-3 text-[15px] text-white placeholder:text-white/55 focus:border-brand focus:outline-none'
    : 'min-w-0 flex-1 rounded-full border border-line bg-paper px-5 py-3 text-[15px] placeholder:text-muted/60 focus:border-accent focus:outline-none';

// The button does not change with tone. It is a solid fill, so its label is
// measured against the fill and not against the page — brand looks brighter on
// ink but puts white at 3.23:1, under AA, where accent gives 5.0:1. Both clear
// 3:1 against the footer background as a shape (6.1 and 4.0), so the only thing
// switching would have bought is a failing label.
const buttonClass =
  'rounded-full bg-accent px-6 py-3 text-[15px] font-medium whitespace-nowrap text-white transition-colors hover:bg-accent-dark';

/**
 * A form with no action POSTs to the current page and drops the address on the
 * floor. Rather than ship that, an unconfigured form renders nothing in
 * production — no input, no button, nothing to type into. The warning below is
 * dev-only so an internal TODO can never reach a visitor again.
 */
const wired = Boolean(site.buttondownUser);
const action = wired
  ? `https://buttondown.email/api/emails/embed-subscribe/${site.buttondownUser}`
  : undefined;
---

{
  wired && (
    <form
      action={action}
      method="post"
      target="_blank"
      class:list={[
        'flex w-full flex-col gap-2.5 sm:flex-row',
        compact ? 'max-w-md' : 'max-w-lg',
      ]}
    >
      <label class="sr-only" for={`email-${tag}`}>
        {label}
      </label>
      <input
        id={`email-${tag}`}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class={fieldClass}
      />
      <input type="hidden" name="tag" value={tag} />
      <button
        type="submit"
        class={buttonClass}
      >
        {cta}
      </button>
    </form>
  )
}

{
  !wired && import.meta.env.DEV && (
    <p class="mt-2.5 text-[13px] text-key">
      Dev only — no <code class="font-mono">buttondownUser</code> set, so this
      form is hidden in production rather than dropping addresses.
    </p>
  )
}

---
import Base from '../layouts/Base.astro';
import { site } from '../config';

/**
 * No form. A form needs somewhere to post, and a form that silently drops
 * messages is worse than none on a site whose whole argument is not
 * surprising people. Mailto links with a subject prefilled do the same job
 * and make triage easier.
 */
const reasons = [
  {
    h: 'You are locked out',
    subject: 'Locked out',
    p: [
      'First, check the app: every Mac gets five emergency unlocks, and they end a session without the key. They are in the top right while a session is running.',
      'If those are gone, or the app will not open, write to us. We will unlock your Mac manually. It is a real person doing it, not a button, so it takes as long as it takes.',
    ],
  },
  {
    h: 'You want a refund, or to cancel',
    subject: 'Refund',
    p: [
      'Cancel any time before your order ships and you get everything back. After it arrives, you have 30 days from delivery. Include your order number if you have it, and we will not ask you why.',
    ],
  },
  {
    h: 'Something about your order',
    subject: 'Order',
    p: [
      'Where it is, changing the address, a parcel that has not turned up, a key that arrived damaged. If it arrived faulty, that is on us and we cover postage both ways.',
    ],
  },
  {
    h: 'Anything else',
    subject: 'Hello',
    p: [
      'Questions before buying, something the site does not answer, a bug, press, or telling us we got something wrong. All of it reaches the same two people.',
    ],
  },
];
---

<Base
  title="Contact | Stick"
  description={`Write to ${site.supportEmail}. A real person answers ${site.unlockResponseTime}.`}
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-14 md:pt-24">
    <h1 class="headline text-hero">Contact</h1>
    <p class="text-lead mt-9 leading-relaxed text-muted">
      One address, and a person on the other end of it. We answer
      {' '}{site.unlockResponseTime}.
    </p>
    <p class="mt-8">
      <a
        href={`mailto:${site.supportEmail}`}
        class="text-[22px] font-semibold tracking-[-0.02em] text-accent underline underline-offset-4"
      >
        {site.supportEmail}
      </a>
    </p>
  </section>

  <section class="rule bg-mist">
    <div class="mx-auto max-w-3xl px-5 py-16 md:py-20">
      <h2 class="headline text-display">What are you writing about?</h2>
      <p class="mt-6 text-[17px] leading-relaxed text-muted">
        Any of these opens a message with the subject already filled in, which
        helps us get to the urgent ones first.
      </p>

      <div class="mt-12 space-y-12">
        {
          reasons.map((r) => (
            <article class="rule pt-7">
              <h3 class="text-[21px] font-semibold tracking-[-0.02em]">{r.h}</h3>
              {r.p.map((para) => (
                <p class="mt-4 text-[17px] leading-relaxed text-muted">{para}</p>
              ))}
              <a
                href={`mailto:${site.supportEmail}?subject=${encodeURIComponent(r.subject)}`}
                class="mt-5 inline-flex items-center gap-2 rounded-full border border-ink px-6 py-3 text-[15px] font-medium transition-colors hover:bg-ink hover:text-white"
              >
                Email us about this
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16 md:py-20">
    <h2 class="headline text-display">Who you are writing to</h2>
    <div class="mt-6 space-y-5 text-[17px] leading-relaxed text-muted">
      <p>
        Ben and Noah, at {site.legalEntity}. There is no support desk and no
        ticket queue, which is why we say one business day rather than
        promising an hour.
      </p>
      <p>
        If you are locked out and it is actually urgent, say so in the subject
        line and we will treat it that way.
      </p>
    </div>
  </section>
</Base>

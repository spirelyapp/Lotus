---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import BuyButton from '../components/BuyButton.astro';
import { faq } from '../data/faq';
import { site } from '../config';
---

<Base
  title="Stick | FAQ"
  description="Questions about Stick: what it blocks, what happens if you lose the key, and what it does not do."
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-10 md:pt-24">
    <h1 class="headline text-hero">Questions</h1>
    <p class="mt-7 text-[17px] leading-relaxed text-muted">
      Everything people ask before buying. If yours isn’t here, write to us.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <Faq items={faq} level={2} />

    {/* The updates log lost its place in the header, so this is now one of the
        ways in. It belongs here: the question underneath most of the ones
        above is "is this real and when does it arrive", and that page is the
        dated answer.

        It is a link rather than an FAQ entry because a FaqItem's answer is a
        plain string — deliberately, so the copy stays in data/faq.ts — and a
        string cannot hold an anchor. */}
    <div class="rule mt-12 pt-8">
      <h2 class="text-[20px] font-semibold tracking-[-0.02em]">
        Where the build has actually got to
      </h2>
      <p class="mt-3 text-[17px] leading-relaxed text-muted">
        Pre-orders are charged before anything ships, so progress gets posted
        and dated on the updates page, including the parts that go badly. It is
        also where a slipped date would appear.
      </p>
      <a
        href="/updates"
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-ink px-6 py-3 text-[15px] font-medium transition-colors hover:bg-ink hover:text-white"
      >
        Read the updates
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="rule bg-mist">
    <div class="mx-auto max-w-3xl px-5 py-20">
      <h2 class="headline text-display">Still wondering something?</h2>
      <p class="mt-6 text-[17px] leading-relaxed text-muted">
        {
          site.supportEmail ? (
            <>
              Write to{' '}
              <a
                href={`mailto:${site.supportEmail}`}
                class="inline-block py-1 text-accent underline underline-offset-4"
              >
                {site.supportEmail}
              </a>
              .
            </>
          ) : (
            <span class="text-key">
              TODO — support email address. Needed before the buy button is
              public: the refunds page and the manual unlock both promise a human here.
            </span>
          )
        }
      </p>
      <div class="mt-9">
        <BuyButton size="lg" />
      </div>
    </div>
  </section>
</Base>

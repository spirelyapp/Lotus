---
import { Image } from 'astro:assets';
import stickKey from '../assets/stick-key.png';
import Base from '../layouts/Base.astro';
import BuyButton from '../components/BuyButton.astro';
import { site } from '../config';

const inTheBox = [
  'The key: USB-C, hot pink, Stick. embossed',
  'The macOS app and background service, with free updates',
  'One key works on every Mac you own',
  'No subscription, ever',
];
---

<Base
  title="Get Stick"
  description={`${site.price}, one time, shipping included. Pre-order. Shipping ${site.shipWindow}, with a limited first batch in ${site.earlyShipWindow}.`}
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-20 md:pt-24">
    <h1 class="headline text-hero">Get Stick</h1>

    <div class="mt-12 grid gap-12 sm:grid-cols-[1fr_1.1fr] sm:items-start">
      <Image
        src={stickKey}
        alt="The Stick: a hot pink USB-C key with Stick. embossed on it"
        widths={[420, 720]}
        sizes="(min-width: 640px) 40vw, 90vw"
        loading="eager"
        class="w-full"
      />

      <div>
        <p class="text-[40px] leading-none font-bold tracking-[-0.03em]">
          {site.price}
        </p>
        <p class="mt-2 text-[15px] text-muted">
          Shipping included. One time, and there’s no subscription.
        </p>

        <ul class="mt-8 space-y-3 text-[16px] text-muted">
          {inTheBox.map((item) => <li class="rule pt-3">{item}</li>)}
        </ul>

        <div class="mt-9">
          <BuyButton target="stripe" size="lg" label={`Pre-order for ${site.price}`} />
        </div>
        <p class="mt-4 text-[14px] text-muted">
          Checkout is handled by Stripe. Ships worldwide.
        </p>
        <p class="mt-2 text-[14px] text-muted">
          Cancel any time before it ships, then 30 days from delivery. See
          <a href="/refunds" class="text-accent underline underline-offset-4">refunds</a>.
        </p>
        <p class="mt-2 text-[14px] text-muted">
          Ordering means you accept the{' '}
          <a href="/terms" class="text-accent underline underline-offset-4">terms of sale</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- The two things a buyer should know before paying, not after. -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-3xl px-5 py-20">
      <h2 class="headline text-display">Before you buy</h2>

      <div class="mt-10 space-y-10">
        <div class="rule pt-6">
          <h3 class="text-[20px] font-semibold tracking-[-0.02em]">
            This is a pre-order
          </h3>
          <p class="mt-3 text-[17px] leading-relaxed text-muted">
            You’re charged today, and the product does not exist on your desk
            yet. Most orders ship in {site.shipWindow}. A limited first batch
            goes out in {site.earlyShipWindow}. If you order now you may be in
            it, but we’re not promising you are.
          </p>
          <p class="mt-3 text-[17px] leading-relaxed text-muted">
            If either date slips, we’ll email you and tell you so, and post it
            on the <a href="/updates" class="text-accent underline underline-offset-4">updates page</a>.
            You can take a full refund at that point, or wait. We’d rather lose
            the sale than quietly hold your money.
          </p>
        </div>

        <div class="rule pt-6">
          <h3 class="text-[20px] font-semibold tracking-[-0.02em]">
            It's friction, not a vault
          </h3>
          <p class="mt-3 text-[17px] leading-relaxed text-muted">
            Stick is built to beat the impulse, not a determined person with
            administrator rights on their own machine. There is no timer to wait
            out and no button that ends a session early. But on a computer you
            control, nothing is absolute, and we would rather say so plainly than
            imply otherwise.
          </p>
          <p class="mt-3 text-[17px] leading-relaxed text-muted">
            If what you want is something that survives an adversary, this isn't
            it. If you want the easy exit to stop existing, that's what we built.
          </p>
        </div>

        <div class="rule pt-6">
          <h3 class="text-[20px] font-semibold tracking-[-0.02em]">
            It needs {site.minMacOS}, on {site.architectures}
          </h3>
          <p class="mt-3 text-[17px] leading-relaxed text-muted">
            macOS only, and there’s no Intel build. If your Mac is pre-2020,
            this won’t run on it. Windows isn’t shipping yet either, and we’d
            rather say that than take your money and a guess.
          </p>
        </div>
      </div>

      <div class="mt-12">
        <BuyButton target="stripe" size="lg" label={`Pre-order for ${site.price}`} />
      </div>
    </div>
  </section>
</Base>

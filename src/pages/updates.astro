---
import Base from '../layouts/Base.astro';
import BuyButton from '../components/BuyButton.astro';
import { updates, inProgress } from '../data/updates';
import { site } from '../config';

/**
 * Exists because people are charged before the product ships. A dated log is
 * the cheapest way to be accountable for that, and it gives the "if it slips
 * we will tell you" promise on /terms somewhere to point.
 */
const latest = updates[0];
---

<Base
  title="Updates | Stick"
  description="What is happening with Stick, dated. Written for people who have already ordered."
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-14 md:pt-24">
    <h1 class="headline text-hero">Updates</h1>
    <div class="mt-9 space-y-5 text-[17px] leading-relaxed text-muted">
      <p>
        You pay for a Stick before it exists on your desk. The least we can do
        is show our working, so this page is where progress gets posted, dated,
        including the parts that go badly.
      </p>
      <p class="text-[15px]">Last updated {latest.date}.</p>
    </div>
  </section>

  <!-- The number people actually came here to check. -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-3xl px-5 py-12">
      <p class="text-[15px] font-medium text-accent">Current shipping estimate</p>
      <p class="mt-3 text-[24px] leading-snug font-semibold tracking-[-0.02em]">
        Most orders ship in {site.shipWindow}, with a limited first batch in
        {' '}{site.earlyShipWindow}.
      </p>
      <p class="mt-4 text-[16px] leading-relaxed text-muted">
        This has not changed since pre-orders opened. If it does, it changes
        here first and by email on the same day, and you can take a full refund
        at that point.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16 md:py-20">
    <h2 class="headline text-display">What we are working on</h2>
    <ul class="mt-8 space-y-4 text-[17px] leading-relaxed text-muted">
      {inProgress.map((item) => <li class="rule pt-4">{item}</li>)}
    </ul>
  </section>

  <section class="rule bg-mist">
    <div class="mx-auto max-w-3xl px-5 py-16 md:py-20">
      <h2 class="headline text-display">The log</h2>

      <ol class="mt-10 space-y-12">
        {
          updates.map((u) => (
            <li>
              <article>
                <time
                  datetime={u.iso}
                  class="text-[15px] font-medium text-muted"
                >
                  {u.date}
                </time>
                <h3 class="mt-2 text-[21px] font-semibold tracking-[-0.02em]">
                  {u.title}
                </h3>
                {u.body.map((para) => (
                  <p class="mt-4 text-[17px] leading-relaxed text-muted">
                    {para}
                  </p>
                ))}
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16 md:py-20">
    <h2 class="headline text-display">Not ordered yet?</h2>
    <p class="mt-6 text-[17px] leading-relaxed text-muted">
      {site.price} + shipping, one time. Shipping {site.shipWindow}. You can
      cancel any time before your order ships and get everything back.
    </p>
    <div class="mt-9">
      <BuyButton size="lg" />
    </div>
  </section>
</Base>

---
import { Image } from 'astro:assets';
import stickInHand from '../assets/stick-in-hand.jpg';
import stickKey from '../assets/stick-key.png';
import howChoose from '../assets/how-choose.png';
import howAway from '../assets/how-away.png';
import howLock from '../assets/how-lock.png';
import Base from '../layouts/Base.astro';
import BuyButton from '../components/BuyButton.astro';
import Faq from '../components/Faq.astro';
import Wordmark from '../components/Wordmark.astro';
import { faq } from '../data/faq';
import { site } from '../config';

// Steps 1 and 3 happen on screen and get a screenshot each. Step 2 happens
// across the room, so it gets a photograph instead — flagged `photo`, because
// webp's default quality is fine for flat UI and visibly mushes the fine
// texture in a photograph.
const steps = [
  {
    n: '1',
    h: 'Choose what to block.',
    p: 'Sites, apps, and bundled category lists. Save them as modes: Deep Work, Sleep, whatever you need. Up to ten.',
    img: howChoose,
    alt: 'The Modes tab in the Stick app, showing a Work mode that blocks 6 apps and 1 site, with its app icons listed and Edit and add buttons.',
  },
  {
    // Deliberately before starting a session, not after. The key is never
    // needed to begin one, so it can already be out of reach.
    n: '2',
    h: 'Keep the key somewhere else.',
    p: 'A drawer, another room, your bag. You never need it to start a session, only to end one, so it can live away from your desk permanently.',
    img: howAway,
    photo: true,
    alt: 'The pink Stick key on a stainless steel fridge door, beside a handwritten shopping list and a photograph, with a kitchen out of focus behind it.',
  },
  {
    n: '3',
    h: 'Start a session.',
    p: 'From the menu bar, or on a schedule. The block goes up immediately and holds through quitting and restarting. The only way to end it is to walk over and plug the key back in.',
    img: howLock,
    alt: 'The Stick app before a session: time locked today, a photo of the pink Stick key, the Work mode blocking 6 apps and 1 site, and one large Lock button.',
  },
];

// Three rows say the same sentence and the fourth breaks the pattern. It reads
// as a punchline rather than a fourth answer — the first three are all a
// location, ours is the category that makes the location matter. A glowing
// pink cell used to do this job by shouting, which read as a template.
const rivals = [
  {
    h: 'Screen Time',
    where: 'On the machine you are trying to leave.',
    p: 'The passcode is one you chose, and you can reset it from that same Mac.',
  },
  {
    h: 'Freedom, Cold Turkey',
    where: 'On the machine you are trying to leave.',
    p: 'Some are genuinely hard to cancel once a session has started, and that part is real. But the key is still software, running in front of you, and the screen is very good at this.',
  },
  {
    h: 'Deleting the app',
    where: 'On the machine you are trying to leave.',
    p: 'Under a minute to reinstall.',
  },
  {
    h: 'Stick',
    where: 'Physical friction.',
    p: 'Accessing distractions means getting up and grabbing the physical key from wherever you left it. A drawer, another room, your bag.',
    ours: true,
  },
];

const modes = [
  'Deep Work',
  'Sleep',
  'Study',
  'Evenings',
  'Writing',
  'Weekends off',
];

const details = [
  {
    h: 'A schedule can start a session, but never end one.',
    p: 'Sleep mode can switch on at 22:00 on weeknights without you deciding to switch it on. There is no matching end time, because that would be a second way out that does not need the key.',
  },
  {
    h: 'You cannot weaken it mid-session.',
    p: 'Once a session is running, the settings are locked too. No quietly removing a site from the list to get around your own block.',
  },
  {
    h: 'Blocking happens in three places at once.',
    p: 'Sites are blocked at two different levels of your system, and blocked apps are closed if you open them. Any one of those on its own would leak.',
  },
  {
    h: 'The usual workarounds are already closed.',
    p: 'The tricks people reach for first, private DNS, hidden browser settings, proxy and VPN services, are shut off while a session runs, along with about 17,500 sites that exist purely to get around blockers.',
  },
  {
    h: 'Browser settings stay changed after a restart.',
    p: 'Browsers only read their settings when they open, so a change that lasted only as long as the session would be useless five seconds after you quit Chrome.',
  },
  {
    h: 'The app cannot let itself out.',
    p: 'The window you click on has no power to unlock anything. It can only ask, and be refused. There is no prompt you can talk yourself into approving.',
  },
];

const homeFaq = faq.filter((f) => f.home);
---

<Base title="Stick | Put the off switch in another room" description={site.description}>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-8">
      <div>
        <h1 class="headline text-hero">Put the off switch<br />in another room.</h1>
        <p class="text-lead mt-7 max-w-lg leading-relaxed text-muted">
          A USB key that blocks the sites and apps you choose, on Mac and
          Windows. Ending a session means physically going to get it.
        </p>

        <div class="mt-9">
          <BuyButton size="lg" />
        </div>

        <p class="mt-4 text-[14px] text-muted">
          {site.price} plus shipping, one time. No subscription.
          Pre-order. Shipping {site.shipWindow}, with a limited first batch in {site.earlyShipWindow}.
        </p>
      </div>

      <div>
        {/* A photograph of the actual key, not the render this used to be.
            No mix-blend-multiply: that existed to drop a white plate out of a
            render, and on a photograph it multiplies the whole frame against
            the page and muddies it. */}
        <Image
          src={stickInHand}
          alt="A hand holding the pink Stick key, with stick. embossed on it, on a lawn in front of a brick building"
          widths={[640, 1024, 1600, 2048]}
          sizes="(min-width: 1024px) 45vw, 92vw"
          quality={90}
          loading="eager"
          class="w-full rounded-2xl"
        />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
      <h2 class="headline text-display max-w-xl">How it works</h2>
      <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((s) => (
            <div class="flex flex-col">
              <p class="text-[15px] font-medium text-accent">{s.n}</p>
              <h3 class="mt-3 text-[21px] font-semibold tracking-[-0.02em]">
                {s.h}
              </h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted">{s.p}</p>
              {
                s.img && (
                  <Image
                    src={s.img}
                    alt={s.alt}
                    widths={[380, 640, 960, 1280]}
                    sizes="(min-width: 768px) 30vw, 90vw"
                    quality={s.photo ? 90 : undefined}
                    class="mt-6 w-full rounded-xl border border-line md:mt-auto md:pt-6"
                  />
                )
              }
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Where the off switch lives. Every row answers the same question, and the
       first three answer it identically — which is the whole argument, made by
       the copy rather than by a border and a glow. Emphasis on our row is
       weight and full white, no accent colour: the pink is carried by the
       logo, the favicon and the product itself, and a fourth use here was what
       made the section look generated. -->
  <section class="rule bg-ink text-white">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
      <h2 class="headline text-display max-w-2xl">
        Every other blocker keeps the key on the same machine.
      </h2>

      <dl class="mt-14 max-w-4xl">
        {
          rivals.map((r) => (
            <div class="grid gap-x-10 gap-y-1.5 border-t border-white/15 py-7 md:grid-cols-[13rem_1fr]">
              <dt
                class:list={[
                  'text-[17px] tracking-[-0.02em]',
                  r.ours ? 'font-bold' : 'font-semibold text-white/90',
                ]}
              >
                {
                  r.ours ? (
                    <>
                      {/* The mark replaces the word, so the row still needs the
                          name in text: Wordmark is aria-hidden and would leave
                          this term empty to a screen reader. mt is optical, to
                          sit the letters on the same line as the terms above
                          rather than at the top of the grid cell. */}
                      <span class="sr-only">Stick</span>
                      <Wordmark
                        blink={false}
                        class="mt-[3px] block w-[66px] select-none"
                      />
                    </>
                  ) : (
                    r.h
                  )
                }
              </dt>
              <dd>
                <p
                  class:list={[
                    'text-[17px] leading-relaxed',
                    r.ours ? 'font-medium' : 'text-white/75',
                  ]}
                >
                  {r.where}
                </p>
                <p class="mt-2 text-[16px] leading-relaxed text-white/55">
                  {r.p}
                </p>
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-12 text-[19px] text-white/70 italic">
        The difference isn’t strength. It’s distance.
      </p>
    </div>
  </section>

  <!-- What you get -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
      <Image
        src={stickKey}
        alt=""
        widths={[420, 720]}
        sizes="(min-width: 1024px) 30vw, 90vw"
        class="w-full max-w-md mix-blend-multiply"
      />
      <div>
        <h2 class="headline text-display">{site.price} plus shipping.</h2>
        <ul class="mt-8 space-y-3 text-[17px] text-muted">
          <li class="rule pt-3">
            The key: USB-C, in hot pink or black, <em>Stick.</em> embossed
          </li>
          <li class="rule pt-3">
            The Mac and Windows apps, with free updates
          </li>
          <li class="rule pt-3">One key works on every Mac and PC you own</li>
          <li class="rule pt-3">No subscription</li>
          <li class="rule pt-3">
            Ships worldwide. Shipping is charged at checkout and depends on
            where you are. Duties and import taxes, where your country charges
            them, are yours too
          </li>
        </ul>

        <div class="mt-9">
          <BuyButton size="lg" />
        </div>
        <p class="mt-4 text-[14px] text-muted">
          Pre-order. Charged today, ships {site.shipWindow}. A limited first
          batch goes out in {site.earlyShipWindow}.
        </p>
        <p class="mt-2 text-[14px] text-muted">
          Cancel before it ships, or 30 days from delivery. See{' '}
          <a href="/refunds" class="text-accent underline underline-offset-4">refunds</a>.
        </p>
      </div>
    </div>
    </div>
  </section>

  <!-- Modes -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <h2 class="headline text-display">Modes</h2>
    <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-muted">
      Each mode is a named set of sites, apps and categories. Switch between
      them, or let a schedule start one for you.
    </p>
    <ul class="mt-10 flex flex-wrap gap-3">
      {
        modes.map((m) => (
          <li class="rounded-full border border-line px-5 py-2.5 text-[15px]">
            {m}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Details -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
      <h2 class="headline text-display max-w-2xl">
        The details we think you’ll care about
      </h2>
      <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-x-14">
        {
          details.map((d) => (
            <div class="rule pt-6">
              <h3 class="text-[19px] font-semibold tracking-[-0.02em]">{d.h}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted">{d.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What it installs -->
  <!-- Lost key -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="headline text-display">If you lose your key</h2>
      <p class="mt-7 text-[17px] leading-relaxed text-muted">
        Two answers, and we’d rather you know both before you buy than
        after.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div class="rule pt-5">
          <h3 class="text-[19px] font-semibold tracking-[-0.02em]">
            Five emergency unlocks
          </h3>
          <p class="mt-3 text-[16px] leading-relaxed text-muted">
            Every Mac gets five, for the times you really need out and the key is
            three hours away. They end a session without it. They do not refill.
            Five is what you get, so spend them like it.
          </p>
        </div>
        <div class="rule pt-5">
          <h3 class="text-[19px] font-semibold tracking-[-0.02em]">
            After that, contact us
          </h3>
          <p class="mt-3 text-[16px] leading-relaxed text-muted">
            Write to us, a real person on the other end, and we’ll unlock
            your machine manually, {site.unlockResponseTime}. Not instantly, on
            purpose: an unlock we granted in five minutes would just be the
            button this whole product exists to remove.
          </p>
        </div>
      </div>

      <p class="mt-8 text-[16px] leading-relaxed text-muted">
        We’d rather you knew both before you buy than discover them
        afterwards.
      </p>
    </div>
  </section>

  <!-- Platforms. This was a Windows section that existed to say Windows did not
       exist. Now that it does, it is one section about both, and there is no
       waitlist form on it: there is nothing left to wait for. -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="max-w-2xl">
        <h2 class="headline text-[clamp(1.75rem,3vw,2.5rem)]">
          Mac and Windows, one key
        </h2>
        <p class="mt-5 text-[17px] leading-relaxed text-muted">
          The key is the same physical object on both, so the Stick that locks
          your Mac unlocks your PC. Set up each machine once and the key is
          adopted rather than replaced — a laptop for work and a desktop at
          home can share one.
        </p>
        <p class="mt-4 text-[17px] leading-relaxed text-muted">
          Blocking works the same way on each: sites stopped at two levels of
          the system, blocked apps closed when you open them, and settings that
          cannot be weakened while a session is running. Both apps come with
          your order at no extra cost, and there is nothing to buy twice.
        </p>
        <p class="mt-4 text-[17px] leading-relaxed text-muted">
          {site.minMacOS}, on {site.architectures}. {site.minWindows}, on{' '}
          {site.windowsArchitectures}. Nothing older, on either side.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="headline text-display">Questions</h2>
      <div class="mt-10">
        <Faq items={homeFaq} />
      </div>
      <a
        href="/faq"
        class="mt-8 inline-block text-[16px] text-accent underline underline-offset-4"
      >
        All questions →
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="rule bg-ink text-white">
    <div class="mx-auto max-w-6xl px-5 py-20 text-center md:py-28">
      <h2 class="headline text-display mx-auto max-w-2xl">
        The only way out is a walk.
      </h2>
      <p class="mt-6 text-[17px] text-white/60">
        {site.price} plus shipping, one time. Ships {site.shipWindow}.
      </p>
      <div class="mt-9 flex justify-center">
        <BuyButton size="lg" />
      </div>
    </div>
  </section>
</Base>

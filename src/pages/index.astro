---
import { Image } from 'astro:assets';
import stickKey from '../assets/stick-key.png';
import howChoose from '../assets/how-choose.png';
import howLock from '../assets/how-lock.png';
import Base from '../layouts/Base.astro';
import EmailForm from '../components/EmailForm.astro';
import BuyButton from '../components/BuyButton.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/faq';
import { site } from '../config';

// The first two steps happen on screen, so each gets a screenshot. The third
// happens in a drawer, and a photograph of a drawer would be filler.
const steps = [
  {
    n: '1',
    h: 'Choose what to block.',
    p: 'Sites, apps, and bundled category lists. Save them as modes: Deep Work, Sleep, whatever you need. Up to ten.',
    img: howChoose,
    alt: 'The Modes tab in the Stick app, showing a Work mode that blocks 6 apps and 1 site, with its app icons listed and Edit and add buttons.',
  },
  {
    // Deliberately before starting a session, not after. The key is never
    // needed to begin one, so it can already be out of reach.
    n: '2',
    h: 'Keep the key somewhere else.',
    p: 'A drawer, another room, your bag. You never need it to start a session, only to end one, so it can live away from your desk permanently.',
  },
  {
    n: '3',
    h: 'Start a session.',
    p: 'From the menu bar, or on a schedule. The block goes up immediately and holds through quitting and restarting. The only way to end it is to walk over and plug the key back in.',
    img: howLock,
    alt: 'The Stick app before a session: time locked today, a photo of the pink Stick key, the Work mode blocking 6 apps and 1 site, and one large Lock button.',
  },
];

const rivals = [
  {
    h: 'Screen Time',
    p: 'The passcode is one you chose, and you can reset it from the same Mac you’re trying to get away from.',
  },
  {
    h: 'Software alternatives',
    p: 'Apps like Freedom and Cold Turkey. Some are genuinely hard to cancel once a session starts, and that part is real. But the key is still software, running on the machine you’re sitting in front of. The fight is between you and a screen, and the screen is very good at this.',
  },
  {
    h: 'Deleting the app',
    p: 'Under a minute to reinstall.',
  },
  {
    h: 'Stick',
    p: 'Unlocking your Mac means getting up and fetching a physical object. That is friction you cannot click past.',
    ours: true,
  },
];

const modes = [
  'Deep Work',
  'Sleep',
  'Study',
  'Evenings',
  'Writing',
  'Weekends off',
];

const details = [
  {
    h: 'A schedule can start a session, but never end one.',
    p: 'Sleep mode can switch on at 22:00 on weeknights without you deciding to switch it on. There is no matching end time, because that would be a second way out that does not need the key.',
  },
  {
    h: 'You cannot weaken it mid-session.',
    p: 'Once a session is running, the settings are locked too. No quietly removing a site from the list to get around your own block.',
  },
  {
    h: 'Blocking happens in three places at once.',
    p: 'Sites are blocked at two different levels of your Mac, and blocked apps are closed if you open them. Any one of those on its own would leak.',
  },
  {
    h: 'The usual workarounds are already closed.',
    p: 'The tricks people reach for first, private DNS, hidden browser settings, proxy and VPN services, are shut off while a session runs, along with about 17,500 sites that exist purely to get around blockers.',
  },
  {
    h: 'Browser settings stay changed after a restart.',
    p: 'Browsers only read their settings when they open, so a change that lasted only as long as the session would be useless five seconds after you quit Chrome.',
  },
  {
    h: 'The app cannot let itself out.',
    p: 'The window you click on has no power to unlock anything. It can only ask, and be refused. There is no prompt you can talk yourself into approving.',
  },
];

const homeFaq = faq.filter((f) => f.home);
---

<Base title="Stick | Put the off switch in another room" description={site.description}>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-8">
      <div>
        <h1 class="headline text-hero">Put the off switch<br />in another room.</h1>
        <p class="text-lead mt-7 max-w-lg leading-relaxed text-muted">
          A USB key that blocks the sites and apps you choose on your Mac.
          Ending a session means physically going to get it.
        </p>

        <div class="mt-9">
          <BuyButton size="lg" />
        </div>

        <p class="mt-4 text-[14px] text-muted">
          {site.price}, one time, shipping included. No subscription, ever.
          Pre-order. Shipping {site.shipWindow}, with a limited first batch in {site.earlyShipWindow}.
        </p>
      </div>

      <div>
        <Image
          src={stickKey}
          alt="The Stick: a hot pink USB-C key with Stick. embossed on it"
          widths={[420, 720, 1200]}
          sizes="(min-width: 1024px) 45vw, 90vw"
          loading="eager"
          class="mx-auto w-full max-w-sm lg:max-w-none"
        />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
      <h2 class="headline text-display max-w-xl">How it works</h2>
      <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((s) => (
            <div class="flex flex-col">
              <p class="text-[15px] font-medium text-accent">{s.n}</p>
              <h3 class="mt-3 text-[21px] font-semibold tracking-[-0.02em]">
                {s.h}
              </h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted">{s.p}</p>
              {
                s.img && (
                  <Image
                    src={s.img}
                    alt={s.alt}
                    widths={[380, 640, 960]}
                    sizes="(min-width: 768px) 30vw, 90vw"
                    class="mt-6 w-full rounded-xl border border-line md:mt-auto md:pt-6"
                  />
                )
              }
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Teardown. Our cell is marked by pink text and a pink border rather than
       a filled background. The brand pink is 5.60:1 on this near-black but only
       1.41:1 on the accent blue, so it can sit on this section but never on a
       blue fill. -->
  <section class="rule bg-ink text-white">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
      <h2 class="headline text-display max-w-2xl">
        Every other blocker keeps the key on the same machine.
      </h2>

      {/* No overflow-hidden: it would clip the glow flat against the cell edge.
          Each corner cell rounds itself instead, so the block keeps its shape. */}
      <div class="mt-14 grid gap-px rounded-2xl bg-white/15 md:grid-cols-2">
        {
          rivals.map((r, i) => (
            <div
              class:list={[
                'bg-ink p-8',
                // Corner radii, now that the container cannot clip them.
                i === 0 && 'rounded-t-2xl md:rounded-t-none md:rounded-tl-2xl',
                i === 1 && 'md:rounded-tr-2xl',
                i === 2 && 'md:rounded-bl-2xl',
                // Our cell: the inside stays the same black as its neighbours.
                // All the pink is on the edge, an outer halo spilling into the
                // section, lifted above the siblings so their backgrounds do
                // not cover it. No text-shadow, which only softens letterforms
                // and reads as being out of focus.
                r.ours &&
                  'relative z-10 border-2 border-key shadow-[0_0_60px_-4px_rgba(255,31,158,0.75)] rounded-b-2xl md:rounded-b-none md:rounded-br-2xl',
              ]}
            >
              <h3
                class:list={[
                  'text-[19px] tracking-[-0.02em]',
                  r.ours ? 'font-bold text-key' : 'font-semibold',
                ]}
              >
                {r.h}
              </h3>
              <p
                class:list={[
                  'mt-3 text-[16px] leading-relaxed',
                  r.ours ? 'font-bold text-key' : 'text-white/60',
                ]}
              >
                {r.p}
              </p>
            </div>
          ))
        }
      </div>

      <p class="mt-10 text-[19px] text-white/70 italic">
        The difference isn’t strength. It’s distance.
      </p>
    </div>
  </section>

  <!-- What you get -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
      <Image
        src={stickKey}
        alt=""
        widths={[420, 720]}
        sizes="(min-width: 1024px) 30vw, 90vw"
        class="w-full max-w-md"
      />
      <div>
        <h2 class="headline text-display">{site.price} including shipping.</h2>
        <ul class="mt-8 space-y-3 text-[17px] text-muted">
          <li class="rule pt-3">
            The key: USB-C, hot pink, <em>Stick.</em> embossed
          </li>
          <li class="rule pt-3">
            The macOS app and background service, with free updates
          </li>
          <li class="rule pt-3">One key works on every Mac you own</li>
          <li class="rule pt-3">No subscription, ever</li>
          <li class="rule pt-3">
            Free shipping worldwide. Duties and import taxes, where your
            country charges them, are still yours
          </li>
        </ul>

        <div class="mt-9">
          <BuyButton size="lg" />
        </div>
        <p class="mt-4 text-[14px] text-muted">
          Pre-order. Charged today, ships {site.shipWindow}. A limited first
          batch goes out in {site.earlyShipWindow}.
        </p>
        <p class="mt-2 text-[14px] text-muted">
          Cancel before it ships, or 30 days from delivery. See{' '}
          <a href="/refunds" class="text-accent underline underline-offset-4">refunds</a>.
        </p>
      </div>
    </div>
    </div>
  </section>

  <!-- Modes -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <h2 class="headline text-display">Modes</h2>
    <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-muted">
      Each mode is a named set of sites, apps and categories. Switch between
      them, or let a schedule start one for you.
    </p>
    <ul class="mt-10 flex flex-wrap gap-3">
      {
        modes.map((m) => (
          <li class="rounded-full border border-line px-5 py-2.5 text-[15px]">
            {m}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Details -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
      <h2 class="headline text-display max-w-2xl">
        The details we think you’ll care about
      </h2>
      <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-x-14">
        {
          details.map((d) => (
            <div class="rule pt-6">
              <h3 class="text-[19px] font-semibold tracking-[-0.02em]">{d.h}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted">{d.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What it installs -->
  <!-- Lost key -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="headline text-display">If you lose your key</h2>
      <p class="mt-7 text-[17px] leading-relaxed text-muted">
        Two answers, and we’d rather you know both before you buy than
        after.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div class="rule pt-5">
          <h3 class="text-[19px] font-semibold tracking-[-0.02em]">
            Five emergency unlocks
          </h3>
          <p class="mt-3 text-[16px] leading-relaxed text-muted">
            Every Mac gets five, for the times you genuinely need out and the key
            is genuinely in another city. They end a session without it. They do
            not refill. Five is what you get, so spend them like it.
          </p>
        </div>
        <div class="rule pt-5">
          <h3 class="text-[19px] font-semibold tracking-[-0.02em]">
            After that, contact us
          </h3>
          <p class="mt-3 text-[16px] leading-relaxed text-muted">
            Email or phone, a real person on the other end, and we’ll unlock
            your Mac manually, {site.unlockResponseTime}. Not instantly, on
            purpose: an unlock we granted in five minutes would just be the
            button this whole product exists to remove.
          </p>
        </div>
      </div>

      <p class="mt-8 text-[16px] leading-relaxed text-muted">
        We’d rather you knew both before you buy than discover them
        afterwards.
      </p>
    </div>
  </section>

  <!-- Windows -->
  <section class="rule bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="max-w-2xl">
        <h2 class="headline text-[clamp(1.75rem,3vw,2.5rem)]">Windows</h2>
        <p class="mt-5 text-[17px] leading-relaxed text-muted">
          We’re actively building it. The key itself is the same object either
          way, so the plan is that one Stick unlocks your Mac and your PC, and
          we’re aiming to have the Windows app ready by the time orders ship
          in {site.shipWindow}.
        </p>
        <p class="mt-4 text-[17px] leading-relaxed text-muted">
          Aiming, not promising. Today Stick is macOS only, and that’s what
          you’re buying if you order now. If Windows matters to you, we’d rather
          you waited for us to say it’s done than take your money on a guess.
        </p>
        <div class="mt-7">
          <EmailForm
            tag="windows"
            label="Email address"
            cta="Tell me when Windows ships"
            compact
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 class="headline text-display">Questions</h2>
      <div class="mt-10">
        <Faq items={homeFaq} />
      </div>
      <a
        href="/faq"
        class="mt-8 inline-block text-[16px] text-accent underline underline-offset-4"
      >
        All questions →
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="rule bg-ink text-white">
    <div class="mx-auto max-w-6xl px-5 py-20 text-center md:py-28">
      <h2 class="headline text-display mx-auto max-w-2xl">
        The only way out is a walk.
      </h2>
      <p class="mt-6 text-[17px] text-white/60">
        {site.price}, one time, shipping included. Ships {site.shipWindow}.
      </p>
      <div class="mt-9 flex justify-center">
        <BuyButton size="lg" />
      </div>
    </div>
  </section>
</Base>
